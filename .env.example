SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
USE_HTTPS=False
ALLOWED_HOSTS=your-domain.com,YOUR_EC2_PUBLIC_IP
CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_PUBLIC_IP,https://your-domain.com

# SQLite (no database server required)
DB_NAME=db.sqlite3

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEB_APP_URL=https://your-domain.com

JWT_SECRET_KEY=change-me-another-long-random-string

# Optional stable Web Push keys. If omitted they are generated once in backend/cache.
# Generate with: python -c "import py_vapid; v=py_vapid.Vapid(); v.generate_keys(); print(v.public_key); print(v.private_pem())"
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@your-domain.com
